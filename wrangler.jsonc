{
  // Cloudflare: publishes the built website (static files) with no server code.
  // The name must match the project's name in the Cloudflare dashboard.
  "name": "showzy-main",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/frontend/dist",
    // Deep links such as /e/<id> or /artists get the app's index.html, so React can route them.
    "not_found_handling": "single-page-application"
  },
  // Required by `wrangler preview`, which the dashboard runs for pull requests
  // (without it that build fails). Empty is fine.
  "previews": {}
}
