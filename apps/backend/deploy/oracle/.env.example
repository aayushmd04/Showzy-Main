# Copy this file to .env on the server and fill in the values. Never commit .env.
#   cp .env.example .env && chmod 600 .env

# Public hostname for the API (point a DNS record at the server first)
DOMAIN=naada-api.duckdns.org

DJANGO_ENV=naada.settings.production

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=PASTE_A_64_CHAR_RANDOM_STRING

# Supabase Session pooler string, with your real password
DATABASE_URL=postgresql://postgres.laolvnptasjhzugafqom:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

REDIS_URL=redis://redis:6379/0

# Hostnames only. Include the frontend host too, or chat WebSockets are refused.
ALLOWED_HOSTS=naada-api.duckdns.org,127.0.0.1

# Frontend address with https://, no trailing slash
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN

PAYMENT_GATEWAY=mock

# Sign-in codes are emailed through SMTP. Leave EMAIL_HOST_USER empty and codes
# go to the server log instead, so nobody can sign in. Brevo example below
# (free, 300 emails/day). See the mail setup guide for other providers.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Naada <noreply@YOUR_DOMAIN>

# Leave empty to disable error reporting
SENTRY_DSN=
