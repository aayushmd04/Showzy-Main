# ─────────────────────────────────────────────────────────────────────────────
# Showzy frontend environment
#
# Copy to .env.local for local development:
#     cp apps/frontend/.env.example apps/frontend/.env.local
#
# READ THIS FIRST — the one thing people get wrong:
#
#   These are BUILD-TIME variables, not run-time variables. Vite reads them
#   while `npm run build` is running and writes the literal values into the
#   JavaScript bundle. Changing VITE_API_BASE on your hosting dashboard does
#   nothing until you trigger a NEW BUILD. Restarting or redeploying the same
#   build will not pick up the new value.
#
#   Only variables whose name starts with VITE_ are exposed to the browser.
#   Anything you put here is PUBLIC — it ships inside a file anyone can read.
#   Never put a secret key, a database password or a Razorpay secret here.
# ─────────────────────────────────────────────────────────────────────────────


# ── VITE_API_BASE  (the only one that actually matters) ──────────────────────
#
# Full URL of the Django API, INCLUDING the /api/v1 path segment and with NO
# trailing slash. src/lib/api.ts appends paths directly onto this value.
#
#   Local dev, backend on your own machine:
#     VITE_API_BASE=http://localhost:8000/api/v1
#
#   Local docker-compose (backend container published on port 8000):
#     VITE_API_BASE=http://localhost:8000/api/v1
#
#   Production (replace with your real backend hostname):
#     VITE_API_BASE=https://naada-api.onrender.com/api/v1
#
# Common mistakes, all of which produce a blank page or "Failed to fetch":
#   ✗ https://naada-api.onrender.com            <- missing /api/v1
#   ✗ https://naada-api.onrender.com/api/v1/    <- trailing slash
#   ✗ http://naada-api.onrender.com/api/v1      <- http, not https; the browser
#                                                  blocks it as mixed content
#
# Whatever you set here, the ORIGIN part of your frontend URL must also appear
# in the backend's CORS_ALLOWED_ORIGINS, or every request is refused by the
# browser. See DEPLOY.md.
VITE_API_BASE=http://localhost:8000/api/v1


# ── Optional. Leave empty. Nothing breaks if these are unset. ────────────────

# Sentry browser error reporting. Empty = error reporting disabled.
VITE_SENTRY_DSN=

# Product analytics. Empty = analytics disabled.
VITE_ANALYTICS_KEY=
VITE_ANALYTICS_HOST=

# Cloudflare Turnstile site key (public). Empty = bot check off. For local work use
# Cloudflare's always-pass test key 1x00000000000000000000AA together with the
# backend secret 1x0000000000000000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=

# Google OAuth client ID (public; same value as the backend's GOOGLE_OAUTH_CLIENT_ID).
# Empty = "Continue with Google" hidden. Add http://localhost:5173 to the client's
# Authorized JavaScript origins to try it locally.
VITE_GOOGLE_CLIENT_ID=
