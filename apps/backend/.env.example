# =============================================================================
# Showzy backend — environment template
#
#   cp .env.example .env      then fill in the values you need.
#
# Every variable below has a safe default in naada/settings/base.py, so a fresh
# clone runs with an empty .env. NEVER commit a real .env — placeholders only.
# =============================================================================

# ── Which settings module to load ────────────────────────────────────────────
# Full dotted path. Read by manage.py, naada/wsgi.py, naada/asgi.py and
# naada/celery.py. Options: naada.settings.local | naada.settings.production
DJANGO_ENV=naada.settings.local

# ── Core Django ──────────────────────────────────────────────────────────────
# 50+ random chars. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Production refuses to boot on the built-in insecure default.
SECRET_KEY=replace-me-with-50-random-characters-before-deploying

# Never True in production — leaks stack traces and settings.
DEBUG=True

# Comma-separated hostnames Django will serve. Add your real domain in prod.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# A single connection URL drives every environment (parsed by dj-database-url).
# Leave unset for the local SQLite file at apps/backend/db.sqlite3.
DATABASE_URL=sqlite:///db.sqlite3

# Supabase — POOLED (pgbouncer, port 6543). Preferred for serverless/PaaS hosts:
# persistent connections and server-side cursors are disabled automatically.
# DATABASE_URL=postgresql://postgres.abcdefghijklmnopqrst:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# Supabase — DIRECT (port 5432). Use for migrations and long-lived workers;
# keeps CONN_MAX_AGE + connection health checks.
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.abcdefghijklmnopqrst.supabase.co:5432/postgres
#
# sslmode=require is applied automatically to every non-sqlite URL.
# DB_SSLMODE=require
# Seconds to keep a connection open on direct (non-pooled) URLs. Default 60.
# DB_CONN_MAX_AGE=60
# Force pooled-connection behaviour on a non-6543 port.
# DB_POOLED=False

# ── Redis (Channels WebSockets + Celery broker/result backend) ───────────────
# Local: redis://localhost:6379/0
# Upstash: Console → your database → "Connect" → the TCP/Redis URL, which starts with
# rediss:// (two s's = TLS) and looks like  rediss://default:<password>@<name>.upstash.io:6379
# Use the TCP URL, not the REST URL: Channels, Celery and the cache all speak the Redis protocol.
# In production, an empty value falls back to the in-memory channel layer
# (single process only) rather than crashing.
REDIS_URL=redis://localhost:6379/0

# ── Email ────────────────────────────────────────────────────────────────────
# Mail is sent through the GoDaddy/Titan mailbox over SMTP. With EMAIL_HOST_USER and
# EMAIL_HOST_PASSWORD set, real SMTP is used; otherwise messages (including OTPs)
# print to the server terminal. An explicit EMAIL_BACKEND wins, so leave it commented.
# Host and ports: GoDaddy → Email → Server settings. Titan: smtp.titan.email,
# 587 with TLS or 465 with SSL. GoDaddy Workspace Email: smtpout.secureserver.net.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# ── Email over HTTPS (Resend): use this on hosts that block the mail ports ───
# Render's free web services cannot reach SMTP ports 25/465/587, so SMTP below times out
# there. With a Resend key set, mail goes out over HTTPS instead and the SMTP settings are
# ignored. Verify showzy.in in Resend first (add the DNS records it shows), then:
RESEND_API_KEY=
# Optional second provider (300/day free). Used when Resend refuses, e.g. at its 100/day cap.
# Verify showzy.in as a sender domain in Brevo, then create an API v3 key.
BREVO_API_KEY=
# Which to try first: "resend,brevo" (default) or "brevo,resend".
EMAIL_PROVIDER_ORDER=resend,brevo
EMAIL_HOST=smtp.titan.email
EMAIL_PORT=587
EMAIL_USE_TLS=True
# For port 465 set EMAIL_USE_SSL=True and EMAIL_USE_TLS=False (Django refuses both).
# EMAIL_USE_SSL=False
# The mailbox login (not an alias) and its password. Never commit these.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=8
# Senders are aliases on the mailbox, so replies reach its inbox. If the server
# insists on the login address as sender, set all three to the mailbox itself.
EMAIL_FROM_AUTH=Showzy <auth@showzy.in>
EMAIL_FROM_TICKETS=Showzy Tickets <tickets@showzy.in>
EMAIL_FROM_ALERTS=Showzy <alerts@showzy.in>
DEFAULT_FROM_EMAIL=Showzy <alerts@showzy.in>

# ── Payments ─────────────────────────────────────────────────────────────────
# Which gateway is live. "mock" (the default) needs no account and no keys:
# the full booking + ticketing flow works and no real money moves.
#
# Setting this to "razorpay" WITHOUT real credentials raises an error rather
# than falling back to the mock — a silent downgrade would mean issuing real
# tickets for money that never moved. See DEPLOY.md.
PAYMENT_GATEWAY=mock

# rzp_test_* keys for the sandbox, rzp_live_* only in production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
# Chosen by you when registering the webhook in the Razorpay dashboard at
#   https://<your-api-host>/api/v1/payments/webhook/razorpay/
# Used to verify the X-Razorpay-Signature header. Requests that fail this
# check are rejected with a 400.
RAZORPAY_WEBHOOK_SECRET=

# ── Sentry (error tracking; fully optional) ──────────────────────────────────
# Leave EMPTY and Sentry stays silently disabled — nothing crashes.
SENTRY_DSN_BACKEND=
# SENTRY_DSN_BACKEND=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
# Fraction of requests traced for performance monitoring (0.0–1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── CORS / CSRF ──────────────────────────────────────────────────────────────
# Comma-separated frontend origins allowed to call the API. Scheme required.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Extra https origins trusted for CSRF in production (defaults to the https
# entries of CORS_ALLOWED_ORIGINS).
# CSRF_TRUSTED_ORIGINS=https://naada.live,https://www.naada.live

# ── Media storage ────────────────────────────────────────────────────────────
# Local filesystem by default.
MEDIA_URL=/media/
MEDIA_ROOT=media/

# S3 / Supabase Storage via django-storages. Object storage is only enabled
# when AWS_STORAGE_BUCKET_NAME is non-empty; otherwise local files are used.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=ap-south-1
# S3-compatible endpoint. Supabase Storage:
#   https://abcdefghijklmnopqrst.supabase.co/storage/v1/s3
AWS_S3_ENDPOINT_URL=
# CDN / custom domain used to build public media URLs, e.g. cdn.naada.live
AWS_S3_CUSTOM_DOMAIN=
# True = signed, expiring URLs. False = public-read objects.
AWS_QUERYSTRING_AUTH=False

# ── Turnstile (bot check on requesting a sign-in code) ───────────────────────
# Secret key from Cloudflare dashboard → Turnstile; pair it with
# VITE_TURNSTILE_SITE_KEY in the frontend build. Empty = check off (dev only).
TURNSTILE_SECRET_KEY=
# Optional: only accept tokens issued on these hostnames, e.g. showzy.in,app.showzy.in
TURNSTILE_ALLOWED_HOSTNAMES=

# ── Google sign-in ───────────────────────────────────────────────────────────
# OAuth client ID (type "Web application") from Google Cloud Console. Public;
# there is no client secret in this flow. Pair it with VITE_GOOGLE_CLIENT_ID
# in the frontend build. Empty = Google sign-in off.
GOOGLE_OAUTH_CLIENT_ID=

# ── OTP login ────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=3
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
# Secret key for the HMAC that protects stored codes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_PEPPER=
# Client IP for throttles. Render alone: leave CLIENT_IP_HEADER empty and
# TRUSTED_PROXY_COUNT=1. Cloudflare in front of Render: TRUSTED_PROXY_COUNT=2,
# or CLIENT_IP_HEADER=CF-Connecting-IP once the origin only accepts Cloudflare.
CLIENT_IP_HEADER=
TRUSTED_PROXY_COUNT=1
# Echo the generated OTP in the API response so you can log in without a mail
# server. Defaults True in local settings, hard-forced False in production —
# enabling it publicly hands account takeover to anyone with an email address.
OTP_DEBUG_RESPONSE=True

# ── Misc production toggles ──────────────────────────────────────────────────
# Set False when TLS is terminated by a proxy that does not forward
# X-Forwarded-Proto, to avoid a redirect loop.
# SECURE_SSL_REDIRECT=True

# ── GST ───────────────────────────────────────────────────────────────────────
# All zero by default: nothing is taxed until you set a rate deliberately.
# Get the correct rates and treatment from a CA before switching these on —
# see apps/tickets/tax.py for exactly what each one does.
#
# A common starting point is 18% on the booking fee (a service you supply) with
# admission exempt below a per-ticket price.
GST_RATE_FEE=0
GST_RATE_TICKET=0
GST_TICKET_EXEMPT_BELOW=0
GSTIN=
INVOICE_SELLER_NAME=Showzy
INVOICE_SELLER_ADDRESS=

# ── Your company details, shown on the public policy pages ────────────────────
# Set these and the Terms / Privacy / Refunds / Contact pages fill themselves in.
# Until they are set those pages say plainly that they are not ready to publish,
# because a payment gateway rejects an application whose policies are blank.
# No rebuild needed — the frontend reads them from the API.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
SUPPORT_EMAIL=
SUPPORT_PHONE=
GRIEVANCE_OFFICER=
POLICIES_UPDATED=

# Showzy fee on an artist booking, as a fraction of the agreed fee (0.05 = 5%).
# Paid by the venue on top of the agreed fee; the artist is never charged.
# Keep it equal to PLATFORM_FEE_RATE in apps/frontend/src/data/fixtures.ts.
PLATFORM_FEE_PCT=0.05
