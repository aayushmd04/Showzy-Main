DEBUG=True
SECRET_KEY=change-me-in-production-use-50-chars-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for local dev, Supabase Postgres for prod)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:pass@host:5432/naada

# Redis (for Django Channels WebSocket + Celery)
REDIS_URL=redis://localhost:6379/0

# Email (console backend locally, SMTP in prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Naada <noreply@naada.live>

# Razorpay (use sandbox keys for local dev)
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# Media storage (local for dev, Supabase Storage / S3 for prod)
MEDIA_URL=/media/
MEDIA_ROOT=media/

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OTP settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
